# Copy to infra/.env (git-ignored) and adjust. Dev placeholders only, never real secrets.
# Hosts use 127.0.0.1, not localhost: on Windows localhost tries ::1 first and each attempt stalls (~5s for Postgres/libpq, ~2s for Redis).
# If the password contains @, / or :, URL-encode it inside DATABASE_URL.
APP_ENV=development
DATABASE_URL=postgresql://explorai:change-me-dev-only@127.0.0.1:5432/explorai
REDIS_URL=redis://127.0.0.1:6379/0
CHECK_TIMEOUT_SECONDS=2
POSTGRES_USER=explorai
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=explorai
