# Copy to .env and adjust. Dev placeholders only, never real secrets.
# Hosts use 127.0.0.1, not localhost: on Windows localhost tries ::1 first and each refused attempt stalls ~2s.
APP_ENV=development
DATABASE_URL=postgresql://explorai:change-me-dev-only@127.0.0.1:5432/explorai
REDIS_URL=redis://127.0.0.1:6379/0
CHECK_TIMEOUT_SECONDS=2
POSTGRES_USER=explorai
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=explorai
