# Copy to infra/.env (git-ignored) and adjust. Dev placeholders only, never real secrets.
# Hosts use 127.0.0.1, not localhost: on Windows localhost tries ::1 first and each attempt stalls (~5s for Postgres/libpq, ~2s for Redis).
# If the password contains @, / or :, URL-encode it inside DATABASE_URL.
APP_ENV=development
DATABASE_URL=postgresql://explorai:change-me-dev-only@127.0.0.1:5432/explorai
REDIS_URL=redis://127.0.0.1:6379/0
CHECK_TIMEOUT_SECONDS=2
POSTGRES_USER=explorai
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=explorai
# Ingestion pipelines. BLOB_DIR is used by native runs; the container uses /data/blobs.
BLOB_DIR=./var/blobs
# Sent in the User-Agent so that arXiv can reach the operator: use a real address.
CONTACT_EMAIL=dev@example.invalid
MAX_DOWNLOAD_BYTES=50000000
EXTRACT_TIMEOUT_SECONDS=60
ARXIV_MIN_INTERVAL_SECONDS=3.0
# User API. ALLOWED_ORIGINS: comma-separated origins accepted on state-changing requests.
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Keep true in production (cookie sent over HTTPS only). The dev Compose stack serves plain HTTP and sets false.
SESSION_COOKIE_SECURE=false
UPLOAD_MAX_BYTES=20000000
# Optional limits (defaults shown): SESSION_IDLE_SECONDS=86400 SESSION_MAX_SECONDS=604800
# LOGIN_MAX_FAILURES_PER_EMAIL=5 LOGIN_MAX_FAILURES_PER_IP=20 LOGIN_WINDOW_SECONDS=900
# UPLOAD_MAX_PER_HOUR=20 MAX_DOCUMENTS_PER_USER=200
# Qdrant vector store (RAG). Dev placeholder key, never a real secret.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=change-me-dev-only
# RAG. RAG_PROVIDER=fake needs no key (tests, CI); real needs both keys below (placeholders, never commit real ones).
RAG_PROVIDER=fake
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Defaults shown; verified against the providers' documentation on 2026-11-01.
# RAG_EMBEDDING_MODEL=voyage-4 RAG_EMBEDDING_DIMENSION=1024 RAG_RERANK_MODEL=rerank-2.5
# RAG_GENERATION_MODEL=claude-sonnet-5-5 RAG_REWRITE_MODEL=claude-haiku-5-5
