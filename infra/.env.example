# Copy to infra/.env and adjust. Dev placeholders only, never real secrets.
APP_ENV=development
DATABASE_URL=postgresql://explorai:change-me-dev-only@127.0.0.1:5432/explorai
REDIS_URL=redis://127.0.0.1:6379/0
CHECK_TIMEOUT_SECONDS=2
POSTGRES_USER=explorai
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=explorai

CONTACT_EMAIL=dev@example.invalid
BLOB_DIR=./var/blobs
ALLOWED_ORIGINS=http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
UPLOAD_MAX_BYTES=20000000
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=change-me-dev-only

# RAG provider keys — leave empty when RAG_PROVIDER=fake (the default).
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
RAG_PROVIDER=fake

# Langfuse observability (optional — used with `python -m explorai_eval.measure --langfuse`).
# Before first use, start the langfuse profile and create the langfuse database:
#   docker compose exec postgres psql -U explorai -c 'CREATE DATABASE langfuse;'
#   docker compose --profile langfuse up -d langfuse
# Then create an API key pair in the Langfuse UI at http://127.0.0.1:3000 and fill in:
LANGFUSE_NEXTAUTH_SECRET=changeme-secret-at-least-32-chars
LANGFUSE_SALT=changeme-salt
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
